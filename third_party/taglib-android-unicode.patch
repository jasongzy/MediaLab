+// JNI and TagLib wide strings contain UTF-16 code units, including surrogate pairs.
+TagLib::String JniStringToString(JNIEnv *env, jstring value) {
+    const jchar *chars = env->GetStringChars(value, nullptr);
+    if (chars == nullptr) return {};
+    const std::wstring text(chars, chars + env->GetStringLength(value));
+    env->ReleaseStringChars(value, chars);
+    return TagLib::String(text);
+}
+
+jstring StringToJniString(JNIEnv *env, const TagLib::String &value) {
+    const std::wstring text = value.toWString();
+    const std::vector<jchar> chars(text.begin(), text.end());
+    return env->NewString(chars.data(), static_cast<jsize>(chars.size()));
+}
